diff --git a/packages/tui/src/component/ploan-surface.tsx b/packages/tui/src/component/ploan-surface.tsx
new file mode 100644
index 0000000..c7007d5
--- /dev/null
+++ b/packages/tui/src/component/ploan-surface.tsx
@@ -0,0 +1,81 @@
+import { useTerminalDimensions } from "@opentui/solid"
+import { RGBA } from "@opentui/core"
+import { createMemo, createSignal, For, onCleanup, onMount, Show } from "solid-js"
+import { useTheme } from "../context/theme"
+
+const source = `${process.env.HOME ?? ""}/.ploan/opencode/background.txt`
+
+export function PloanSurface() {
+  const dimensions = useTerminalDimensions()
+  const { theme } = useTheme()
+  const [content, setContent] = createSignal("")
+  const color = createMemo(() => RGBA.fromValues(theme.textMuted.r, theme.textMuted.g, theme.textMuted.b, theme.textMuted.a * 0.35))
+
+  const refresh = async () => {
+    if (!source.startsWith("/")) return setContent("")
+    const file = Bun.file(source)
+    if (!(await file.exists())) return setContent("")
+    setContent(await file.text())
+  }
+
+  onMount(() => {
+    void refresh()
+    const interval = setInterval(() => void refresh(), 1000)
+    interval.unref()
+    onCleanup(() => clearInterval(interval))
+  })
+
+  const sceneLines = createMemo(() => content().split("\n").filter((line) => line.trim().length > 0))
+  const canvas = createMemo(() => {
+    const width = Math.max(1, dimensions().width)
+    const height = Math.max(1, dimensions().height)
+    const rawLines = content().split("\n")
+    const hasCanvas = rawLines.length >= 12 && rawLines.some((line) => line.length >= width * 0.7)
+    if (hasCanvas) {
+      return Array.from({ length: height }, (_, row) => (rawLines[row] ?? "").slice(0, width).padEnd(width, " "))
+    }
+
+    const lines = sceneLines().slice(0, Math.max(1, height - 4)).map((line) => line.slice(0, Math.max(1, width - 4)))
+    const top = Math.max(1, Math.floor((height - lines.length) / 3))
+
+    return Array.from({ length: height }, (_, row) => {
+      const scene = lines[row - top]
+      if (scene === undefined) return ambientLine(width, row)
+      return overlayLine(ambientLine(width, row), scene, Math.max(0, Math.floor((width - scene.length) / 2)))
+    })
+  })
+
+  return (
+    <Show when={sceneLines().length > 0}>
+      <box
+        position="absolute"
+        zIndex={0}
+        top={0}
+        left={0}
+        width={dimensions().width}
+        height={dimensions().height}
+      >
+        <For each={canvas()}>
+          {(line) => (
+            <text fg={color()} wrapMode="none" width={dimensions().width}>
+              {line}
+            </text>
+          )}
+        </For>
+      </box>
+    </Show>
+  )
+}
+
+function ambientLine(width: number, row: number) {
+  return Array.from({ length: width }, (_, column) => {
+    if ((column + row * 7) % 53 === 0) return "·"
+    if (row % 6 === 0 && column % 31 < 4) return "░"
+    if (row % 11 === 0 && column > width - 18 && column % 3 === 0) return "▒"
+    return " "
+  }).join("")
+}
+
+function overlayLine(base: string, text: string, left: number) {
+  return base.slice(0, left) + text + base.slice(Math.min(base.length, left + text.length))
+}
