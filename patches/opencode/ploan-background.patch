+package ploanbg
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/charmbracelet/lipgloss"
+)
+
+// View loads the current Ploan visual surface from ~/.ploan/opencode/background.txt.
+// It is intentionally file-backed so an external Ploan MCP tool can update the
+// surface without needing to be linked into OpenCode.
+func View(maxWidth, maxHeight int) string {
+	if maxWidth < 20 || maxHeight < 8 {
+		return ""
+	}
+
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return ""
+	}
+
+	path := filepath.Join(home, ".ploan", "opencode", "background.txt")
+	data, err := os.ReadFile(path)
+	if err != nil || len(data) == 0 {
+		return ""
+	}
+
+	lines := strings.Split(strings.TrimRight(string(data), "\n"), "\n")
+	if len(lines) == 0 {
+		return ""
+	}
+
+	limitHeight := maxHeight - 6
+	if limitHeight < 4 {
+		limitHeight = 4
+	}
+	if len(lines) > limitHeight {
+		lines = lines[:limitHeight]
+	}
+
+	limitWidth := maxWidth - 6
+	if limitWidth < 20 {
+		limitWidth = 20
+	}
+	for i, line := range lines {
+		if lipgloss.Width(line) > limitWidth {
+			lines[i] = truncateVisible(line, limitWidth)
+		}
+	}
+
+	return strings.Join(lines, "\n")
+}
+
+func truncateVisible(s string, width int) string {
+	if width <= 0 {
+		return ""
+	}
+	var b strings.Builder
+	visible := 0
+	for _, r := range s {
+		if visible >= width {
+			break
+		}
+		b.WriteRune(r)
+		visible++
+	}
+	return b.String()
+}
