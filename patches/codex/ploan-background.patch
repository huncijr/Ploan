+//! Ploan file-backed terminal background layer.
+//!
+//! Reads `~/.ploan/codex/background.txt` and paints it into empty cells after
+//! the main chat widget renders. Leading and trailing blank rows are ignored,
+//! and the visible art is aligned to the bottom of the current Codex viewport.
+
+use std::fs;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+
+const CACHE_TTL_MS: u128 = 2000;
+const COMPOSER_MARGIN_ROWS: u16 = 2;
+
+struct CachedBackground {
+    lines: Vec<String>,
+    loaded_at: Instant,
+}
+
+static CACHE: OnceLock<std::sync::Mutex<Option<CachedBackground>>> = OnceLock::new();
+
+fn background_path() -> PathBuf {
+    let home = std::env::var("HOME").unwrap_or_default();
+    PathBuf::from(home)
+        .join(".ploan")
+        .join("codex")
+        .join("background.txt")
+}
+
+fn load_lines() -> Vec<String> {
+    let path = background_path();
+    match fs::read_to_string(&path) {
+        Ok(content) => content.lines().map(String::from).collect(),
+        Err(_) => Vec::new(),
+    }
+}
+
+fn get_cached_lines() -> Vec<String> {
+    let cache = CACHE.get_or_init(|| std::sync::Mutex::new(None));
+    let mut guard = match cache.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let now = Instant::now();
+    if let Some(cached) = guard.as_ref()
+        && now.duration_since(cached.loaded_at).as_millis() < CACHE_TTL_MS
+    {
+        return cached.lines.clone();
+    }
+    let lines = load_lines();
+    *guard = Some(CachedBackground {
+        lines: lines.clone(),
+        loaded_at: now,
+    });
+    lines
+}
+
+/// Paint the Ploan background into empty buffer cells after other widgets.
+pub(crate) fn render_ploan_background(area: Rect, buf: &mut Buffer) {
+    let lines = get_cached_lines();
+    render_lines_bottom_aligned(area, buf, &lines);
+}
+
+fn render_lines_bottom_aligned(area: Rect, buf: &mut Buffer, lines: &[String]) {
+    let Some(first_art_row) = lines.iter().position(|line| !line.trim().is_empty()) else {
+        return;
+    };
+    let last_art_row = lines
+        .iter()
+        .rposition(|line| !line.trim().is_empty())
+        .unwrap_or(first_art_row);
+    let art = &lines[first_art_row..=last_art_row];
+    let composer_margin = COMPOSER_MARGIN_ROWS.min(area.height.saturating_sub(1));
+    let available_height = area.height.saturating_sub(composer_margin) as usize;
+    let visible_start = art.len().saturating_sub(available_height);
+    let visible_art = &art[visible_start..];
+    let start_y = area
+        .bottom()
+        .saturating_sub(composer_margin)
+        .saturating_sub(visible_art.len().min(available_height) as u16);
+    let dim = Style::default().fg(Color::DarkGray);
+    for (row_offset, line) in visible_art.iter().enumerate() {
+        let y = start_y + row_offset as u16;
+        for (col_offset, ch) in line.chars().enumerate() {
+            if ch == ' ' {
+                continue;
+            }
+            let x = area.x + col_offset as u16;
+            if x >= area.right() {
+                break;
+            }
+            let cell = &buf[(x, y)];
+            let symbol = cell.symbol();
+            if symbol != " " && symbol != "\u{0}" {
+                continue;
+            }
+            buf[(x, y)].set_char(ch);
+            buf[(x, y)].set_style(dim);
+        }
+    }
+}
+
