@@ -0,0 +1,247 @@
+//! Ploan scrollback art emission.
+//!
+//! Codex draws only a small inline viewport; most of the visible screen above
+//! it is terminal scrollback owned by previous output. This module turns
+//! `~/.ploan/codex/background.txt` into history lines inserted above the
+//! viewport through Codex's own `insert_history_lines` mechanism, so the Ploan
+//! background can span multiple rows instead of fitting into the viewport
+//! strip.
+//!
+//! Emission happens once per process for the current content, and again only
+//! after the file changes and stays unchanged for a short stability window
+//! (this avoids stacking every intermediate attempt from an agent redraw
+//! loop). Behavior is configurable in `~/.ploan/codex/config.json`:
+//!
+//! ```json
+//! { "scrollback_art": true, "viewport_art": true, "max_rows": 6 }
+//! ```
+
+use std::collections::hash_map::DefaultHasher;
+use std::fs;
+use std::hash::Hash;
+use std::hash::Hasher;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::time::Duration;
+use std::time::Instant;
+use std::time::SystemTime;
+
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+const CACHE_TTL_MS: u128 = 2000;
+const MAX_ROW_LIMIT: u16 = 12;
+const STABILITY_WINDOW: Duration = Duration::from_secs(8);
+
+#[derive(Clone)]
+pub(crate) struct PloanConfig {
+    pub scrollback_art: bool,
+    pub viewport_art: bool,
+    pub max_rows: u16,
+}
+
+impl Default for PloanConfig {
+    fn default() -> Self {
+        Self {
+            scrollback_art: true,
+            viewport_art: true,
+            max_rows: 6,
+        }
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(default)]
+struct ConfigFile {
+    scrollback_art: bool,
+    viewport_art: bool,
+    max_rows: u16,
+}
+
+impl Default for ConfigFile {
+    fn default() -> Self {
+        Self {
+            scrollback_art: true,
+            viewport_art: true,
+            max_rows: 6,
+        }
+    }
+}
+
+struct ScrollbackState {
+    emitted_hash: String,
+    first_emission_done: bool,
+    last_viewport_y: Option<u16>,
+    growth_since_emit: u16,
+}
+
+static CONFIG_CACHE: OnceLock<std::sync::Mutex<Option<(PloanConfig, Instant)>>> = OnceLock::new();
+static STATE: OnceLock<std::sync::Mutex<Option<ScrollbackState>>> = OnceLock::new();
+
+fn config_path() -> PathBuf {
+    let home = std::env::var("HOME").unwrap_or_default();
+    PathBuf::from(home)
+        .join(".ploan")
+        .join("codex")
+        .join("config.json")
+}
+
+pub(crate) fn parse_config(json: &str) -> PloanConfig {
+    let parsed: ConfigFile = serde_json::from_str(json).unwrap_or_default();
+    PloanConfig {
+        scrollback_art: parsed.scrollback_art,
+        viewport_art: parsed.viewport_art,
+        max_rows: parsed.max_rows.clamp(1, MAX_ROW_LIMIT),
+    }
+}
+
+pub(crate) fn current_config() -> PloanConfig {
+    let cache = CONFIG_CACHE.get_or_init(|| std::sync::Mutex::new(None));
+    let mut guard = match cache.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let now = Instant::now();
+    if let Some((config, loaded_at)) = guard.as_ref()
+        && now.duration_since(*loaded_at).as_millis() < CACHE_TTL_MS
+    {
+        return config.clone();
+    }
+    let config = parse_config(&fs::read_to_string(config_path()).unwrap_or_default());
+    *guard = Some((config.clone(), now));
+    config
+}
+
+pub(crate) fn trimmed_art_lines(lines: &[String], max_rows: u16) -> Vec<String> {
+    let Some(first) = lines.iter().position(|line| !line.trim().is_empty()) else {
+        return Vec::new();
+    };
+    let last = lines
+        .iter()
+        .rposition(|line| !line.trim().is_empty())
+        .unwrap_or(first);
+    let art: Vec<String> = lines[first..=last]
+        .iter()
+        .map(|line| line.trim_end().to_string())
+        .collect();
+    let start = art.len().saturating_sub(max_rows as usize);
+    art[start..].to_vec()
+}
+
+pub(crate) fn content_hash(lines: &[String]) -> String {
+    let mut hasher = DefaultHasher::new();
+    for line in lines {
+        line.hash(&mut hasher);
+        "\n".hash(&mut hasher);
+    }
+    format!("{:016x}", hasher.finish())
+}
+
+fn file_is_stable() -> bool {
+    let modified = match fs::metadata(super::ploan_background::background_path())
+        .and_then(|meta| meta.modified())
+    {
+        Ok(modified) => modified,
+        Err(_) => return true,
+    };
+    SystemTime::now()
+        .duration_since(modified)
+        .map(|age| age >= STABILITY_WINDOW)
+        .unwrap_or(true)
+}
+
+fn state_guard() -> std::sync::MutexGuard<'static, Option<ScrollbackState>> {
+    let state = STATE.get_or_init(|| std::sync::Mutex::new(None));
+    match state.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    }
+}
+
+/// History lines that should be inserted above the viewport right now, if the
+/// Ploan background changed enough to (re)emit.
+///
+/// Emission happens on the first draw with content, and again when the content
+/// changes and stays unchanged for the stability window. Growing the viewport
+/// (for example while an agent run streams output) scrolls the rows above it
+/// upward, eventually pushing the art off the visible screen; once the
+/// viewport snaps back down after the run, the accumulated growth is used to
+/// decide whether the art was likely displaced and needs re-insertion.
+pub(crate) fn take_pending_history_lines() -> Option<Vec<Line<'static>>> {
+    let config = current_config();
+    if !config.scrollback_art {
+        return None;
+    }
+    let art = trimmed_art_lines(
+        &super::ploan_background::cached_background_lines(),
+        config.max_rows,
+    );
+    if art.is_empty() {
+        return None;
+    }
+    let hash = content_hash(&art);
+    let viewport_y = super::ploan_background::last_viewport_y();
+    let mut guard = state_guard();
+    let state = guard.get_or_insert(ScrollbackState {
+        emitted_hash: String::new(),
+        first_emission_done: false,
+        last_viewport_y: None,
+        growth_since_emit: 0,
+    });
+    let mut displaced_art = false;
+    if let (Some(previous_y), Some(current_y)) = (state.last_viewport_y, viewport_y) {
+        if current_y < previous_y {
+            state.growth_since_emit = state
+                .growth_since_emit
+                .saturating_add(previous_y - current_y);
+        } else if current_y > previous_y {
+            displaced_art = state.growth_since_emit >= art.len() as u16;
+            state.growth_since_emit = 0;
+        }
+    }
+    if viewport_y.is_some() {
+        state.last_viewport_y = viewport_y;
+    }
+    if state.emitted_hash == hash {
+        if !displaced_art {
+            return None;
+        }
+    } else if state.first_emission_done && !file_is_stable() {
+        return None;
+    }
+    state.emitted_hash = hash;
+    state.first_emission_done = true;
+    state.growth_since_emit = 0;
+    let dim = Style::default().fg(Color::DarkGray);
+    Some(
+        art.into_iter()
+            .map(|text| Line::from(Span::styled(text, dim)))
+            .collect(),
+    )
+}
+
+/// True when the viewport strip painter should stay quiet: either the config
+/// disabled it, or the current scrollback emission already shows this exact
+/// content above the viewport and painting it again would duplicate rows.
+pub(crate) fn viewport_paint_enabled(lines: &[String]) -> bool {
+    let config = current_config();
+    if !config.viewport_art {
+        return false;
+    }
+    let art = trimmed_art_lines(lines, config.max_rows);
+    if art.is_empty() {
+        return true;
+    }
+    if !config.scrollback_art {
+        return true;
+    }
+    let hash = content_hash(&art);
+    let guard = state_guard();
+    !matches!(guard.as_ref(), Some(state) if state.emitted_hash == hash)
+}
+
+#[cfg(test)]
+#[path = "ploan_scrollback_tests.rs"]
+mod tests;
