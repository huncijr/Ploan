+use pretty_assertions::assert_eq;
+
+use super::PloanConfig;
+use super::content_hash;
+use super::parse_config;
+use super::trimmed_art_lines;
+
+#[test]
+fn trims_blank_rows_and_caps_from_bottom() {
+    let lines = vec![
+        "".to_string(),
+        "AAAA".to_string(),
+        "BBBB".to_string(),
+        "CCCC".to_string(),
+        "".to_string(),
+    ];
