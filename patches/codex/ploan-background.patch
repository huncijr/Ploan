+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+
+use super::format_dimensions;
+use super::largest_empty_band;
+use super::render_art_in_empty_band;
+
+fn paint(area: Rect, buffer: &mut Buffer, lines: &[String]) {
+    if let Some((top, height)) = largest_empty_band(area, buffer) {
+        render_art_in_empty_band(area, buffer, lines, top, height);
+    }
+}
+
+#[test]
+fn caps_art_rows_and_bottom_aligns_inside_empty_viewport() {
+    let area = Rect::new(0, 0, 4, 8);
+    let mut buffer = Buffer::empty(area);
+    let lines = vec![
+        "AAAA".to_string(),
+        "BBBB".to_string(),
+        "CCCC".to_string(),
+        "DDDD".to_string(),
+        "EEEE".to_string(),
+        "FFFF".to_string(),
+        "GGGG".to_string(),
+    ];
+
+    paint(area, &mut buffer, &lines);
+
+    assert_eq!(buffer[(0, 3)].symbol(), "C");
+    assert_eq!(buffer[(0, 7)].symbol(), "G");
+    assert_eq!(buffer[(0, 2)].symbol(), " ");
+}
+
+#[test]
+fn paints_into_largest_empty_band_anywhere() {
+    let area = Rect::new(0, 0, 8, 6);
+    let mut buffer = Buffer::empty(area);
+    buffer[(1, 3)].set_char('Y');
+    buffer[(6, 5)].set_char('X');
+    let lines = vec![
+        "--------".to_string(),
+        "########".to_string(),
+        "========".to_string(),
+        "~~~~~~~~".to_string(),
+    ];
+
+    paint(area, &mut buffer, &lines);
+
+    assert_eq!(buffer[(0, 0)].symbol(), "#");
+    assert_eq!(buffer[(0, 2)].symbol(), "~");
+    assert_eq!(buffer[(0, 4)].symbol(), " ");
+    assert_eq!(buffer[(1, 3)].symbol(), "Y");
+    assert_eq!(buffer[(6, 5)].symbol(), "X");
+}
+
+#[test]
+fn treats_styled_cells_as_occupied() {
+    let area = Rect::new(0, 0, 4, 4);
+    let mut buffer = Buffer::empty(area);
+    buffer[(0, 3)].set_style(Style::default().bg(Color::Blue));
+    buffer[(0, 2)].set_char('c');
+    let lines = vec!["****".to_string()];
+
+    paint(area, &mut buffer, &lines);
+
+    assert_eq!(buffer[(0, 1)].symbol(), "*");
+    assert_eq!(buffer[(0, 2)].symbol(), "c");
+    assert_eq!(buffer[(0, 3)].symbol(), " ");
+}
+
+#[test]
+fn preserves_existing_ui_cells() {
+    let area = Rect::new(0, 0, 8, 5);
+    let mut buffer = Buffer::empty(area);
+    buffer[(1, 1)].set_char('X');
+    let lines = vec!["--------".to_string(), "########".to_string()];
+
+    paint(area, &mut buffer, &lines);
+
+    assert_eq!(buffer[(0, 3)].symbol(), "-");
+    assert_eq!(buffer[(1, 1)].symbol(), "X");
+    assert_eq!(buffer[(0, 4)].symbol(), "#");
+}
+
+#[test]
+fn prefers_lower_band_on_ties() {
+    let area = Rect::new(0, 0, 8, 5);
+    let mut buffer = Buffer::empty(area);
+    buffer[(0, 2)].set_char('X');
+    let lines = vec!["********".to_string()];
+
+    paint(area, &mut buffer, &lines);
+
+    assert_eq!(buffer[(0, 4)].symbol(), "*");
+    assert_eq!(buffer[(0, 1)].symbol(), " ");
+}
+
+#[test]
+fn returns_none_when_no_empty_row_exists() {
+    let area = Rect::new(0, 0, 2, 2);
+    let mut buffer = Buffer::empty(area);
+    buffer[(0, 0)].set_char('a');
+    buffer[(1, 1)].set_char('b');
+
+    assert_eq!(largest_empty_band(area, &buffer), None);
+}
+
+#[test]
+fn formats_dimensions_json() {
+    let area = Rect::new(0, 0, 136, 14);
+
+    assert_eq!(
+        format_dimensions(area, 9, 3),
+        "{\"width\":136,\"height\":3,\"viewport_height\":14,\"top\":9}"
+    );
+}
