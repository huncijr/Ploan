index 0000000..bc462f5
--- /dev/null
+++ b/codex-rs/tui/src/app/ploan_background.rs
@@ -0,0 +1,212 @@
+//! Ploan file-backed terminal background layer.
+//!
+//! Reads `~/.ploan/codex/background.txt` after the main chat widget renders,
+//! finds the largest contiguous fully-empty row band anywhere in the viewport
+//! (ties go to the lower band so art stays near the composer), paints the art
+//! bottom-aligned inside that band, and publishes the measured band size to
+//! `~/.ploan/codex/dimensions.json` so the Ploan MCP server can tell the
+//! agent exactly how many rows are usable.
+
+use std::fs;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU16;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+
+const CACHE_TTL_MS: u128 = 2000;
+const MAX_ART_ROWS: u16 = 5;
+const NO_VIEWPORT_Y: u16 = u16::MAX;
+
+static LAST_VIEWPORT_Y: AtomicU16 = AtomicU16::new(NO_VIEWPORT_Y);
+
+struct CachedBackground {
+    lines: Vec<String>,
+    loaded_at: Instant,
+}
+
+static CACHE: OnceLock<std::sync::Mutex<Option<CachedBackground>>> = OnceLock::new();
+static LAST_DIMENSIONS: OnceLock<std::sync::Mutex<Option<String>>> = OnceLock::new();
+
+pub(crate) fn background_path() -> PathBuf {
+    let home = std::env::var("HOME").unwrap_or_default();
+    PathBuf::from(home)
+        .join(".ploan")
+        .join("codex")
+        .join("background.txt")
+}
+
+pub(crate) fn dimensions_path() -> PathBuf {
+    background_path().with_file_name("dimensions.json")
+}
+
+fn load_lines() -> Vec<String> {
+    let path = background_path();
+    match fs::read_to_string(&path) {
+        Ok(content) => content.lines().map(String::from).collect(),
+        Err(_) => Vec::new(),
+    }
+}
+
+fn get_cached_lines() -> Vec<String> {
+    let cache = CACHE.get_or_init(|| std::sync::Mutex::new(None));
+    let mut guard = match cache.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let now = Instant::now();
+    if let Some(cached) = guard.as_ref()
+        && now.duration_since(cached.loaded_at).as_millis() < CACHE_TTL_MS
+    {
+        return cached.lines.clone();
+    }
+    let lines = load_lines();
+    *guard = Some(CachedBackground {
+        lines: lines.clone(),
+        loaded_at: now,
+    });
+    lines
+}
+
+pub(crate) fn cached_background_lines() -> Vec<String> {
+    get_cached_lines()
+}
+
+pub(crate) fn last_viewport_y() -> Option<u16> {
+    match LAST_VIEWPORT_Y.load(Ordering::Relaxed) {
+        NO_VIEWPORT_Y => None,
+        y => Some(y),
+    }
+}
+
+/// Paint the Ploan background into empty buffer cells after other widgets.
+pub(crate) fn render_ploan_background(area: Rect, buf: &mut Buffer) {
+    LAST_VIEWPORT_Y.store(area.y, Ordering::Relaxed);
+    let lines = get_cached_lines();
+    let Some((band_top, band_height)) = largest_empty_band(area, buf) else {
+        write_dimensions(&format_dimensions(area, area.bottom(), 0));
+        return;
+    };
+    if !super::ploan_scrollback::viewport_paint_enabled(&lines) {
+        write_dimensions(&format_dimensions(area, band_top, band_height));
+        return;
+    }
+    render_art_in_empty_band(area, buf, &lines, band_top, band_height);
+}
+
+fn row_is_empty(buf: &Buffer, area: Rect, y: u16) -> bool {
+    for x in area.left()..area.right() {
+        let cell = &buf[(x, y)];
+        if cell.symbol() != " " || cell.bg != Color::Reset {
+            return false;
+        }
+    }
+    true
+}
+
+/// Largest contiguous fully-empty row band anywhere inside `area`.
+/// Returns `(top, height)` where height is capped at `MAX_ART_ROWS` so an
+/// almost empty fresh session does not claim the whole viewport. Ties prefer
+/// the band that sits lower on screen.
+fn largest_empty_band(area: Rect, buf: &Buffer) -> Option<(u16, u16)> {
+    let mut best: Option<(u16, u16)> = None;
+    let mut start: Option<u16> = None;
+    for y in area.top()..area.bottom() {
+        if row_is_empty(buf, area, y) {
+            start.get_or_insert(y);
+            continue;
+        }
+        if let Some(band_start) = start.take() {
+            let capped = (y - band_start).min(MAX_ART_ROWS);
+            let top = y - capped;
+            if best.is_none_or(|(_, best_height)| best_height <= capped) {
+                best = Some((top, capped));
+            }
+        }
+    }
+    if let Some(band_start) = start {
+        let capped = (area.bottom() - band_start).min(MAX_ART_ROWS);
+        let top = area.bottom() - capped;
+        if best.is_none_or(|(_, best_height)| best_height <= capped) {
+            best = Some((top, capped));
+        }
+    }
+    best
+}
+
+fn format_dimensions(area: Rect, top: u16, height: u16) -> String {
+    format!(
+        "{{\"width\":{},\"height\":{},\"viewport_height\":{},\"top\":{}}}",
+        area.width, height, area.height, top
+    )
+}
+
+fn write_dimensions(json: &str) {
+    let cache = LAST_DIMENSIONS.get_or_init(|| std::sync::Mutex::new(None));
+    let mut guard = match cache.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    if guard.as_deref() == Some(json) {
+        return;
+    }
+    let path = dimensions_path();
+    if let Some(parent) = path.parent()
+        && fs::create_dir_all(parent).is_err()
+    {
+        return;
+    }
+    if fs::write(&path, json).is_err() {
+        return;
+    }
+    *guard = Some(json.to_string());
+}
+
+fn render_art_in_empty_band(
+    area: Rect,
+    buf: &mut Buffer,
+    lines: &[String],
+    band_top: u16,
+    band_height: u16,
+) {
+    let Some(first_art_row) = lines.iter().position(|line| !line.trim().is_empty()) else {
+        return;
+    };
+    let last_art_row = lines
+        .iter()
+        .rposition(|line| !line.trim().is_empty())
+        .unwrap_or(first_art_row);
+    let art = &lines[first_art_row..=last_art_row];
+    let visible_start = art.len().saturating_sub(band_height as usize);
+    let visible_art = &art[visible_start..];
+    let start_y = band_top + band_height - visible_art.len() as u16;
+    let dim = Style::default().fg(Color::DarkGray);
+    for (row_offset, line) in visible_art.iter().enumerate() {
+        let y = start_y + row_offset as u16;
+        for (col_offset, ch) in line.chars().enumerate() {
+            if ch == ' ' {
+                continue;
+            }
+            let x = area.x + col_offset as u16;
+            if x >= area.right() {
+                break;
+            }
+            let cell = &buf[(x, y)];
+            let symbol = cell.symbol();
+            if symbol != " " && symbol != "\u{0}" {
+                continue;
+            }
+            buf[(x, y)].set_char(ch);
+            buf[(x, y)].set_style(dim);
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "ploan_background_tests.rs"]
+mod tests;
